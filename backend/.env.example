# Optional: To fetch specific private submission types and avoid LeetCode rate limits
LEETCODE_SESSION=your_leetcode_session_cookie

# Optional: To enable persistent cloud storage for the plagiarism reports (e.g., Supabase or Cloudflare R2 S3)
S3_BUCKET_NAME=your_s3_bucket_name
S3_ENDPOINT_URL=https://your-s3-endpoint-url.com
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# Optional: Port for the backend server (default: 5050)
PORT=5050
